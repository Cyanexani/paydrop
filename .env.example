# Copy to .env.local and fill in what you have. Never commit real keys; this repo is public.
# Everything works without keys: AI features fall back to deterministic demo modes.

# --- AI (Claude) ---
ANTHROPIC_API_KEY=
# AI_MODE=mock            # force the demo AI even with a key; AI_MODE=claude forces Claude
# CHECKER_JUDGE=heuristic # checker without Claude (deterministic probes only)

# --- AI agent workers (OpenRouter) ---
# BuildBot runs each milestone on the models the client picks, priced from OpenRouter's public
# price list (no key needed for prices). With a key, the models really do the work.
OPENROUTER_API_KEY=
# AGENT_CATALOG=snapshot  # use the saved price list instead of fetching live prices

# --- PayPal (sandbox) ---
# developer.paypal.com → Apps & Credentials → Sandbox → create an app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Webhook ID from the same app's Webhooks section (needed to verify webhook signatures).
PAYPAL_WEBHOOK_ID=
# Currency PayPal holds the money in. INR is not on PayPal's REST currency list:
# run `npm run paypal:currency-check`; keep USD unless INR works in your sandbox.
PAYPAL_CURRENCY=USD
# INR → USD rate locked into each contract at signing when PAYPAL_CURRENCY=USD.
FX_INR_PER_USD=84
# Send every sandbox payout to one sandbox personal account (Payouts need a real sandbox email).
DEMO_PAYOUT_EMAIL=

# --- Kernel (AI checker's cloud browser + replays) ---
# Without it the checker uses a local headless Chromium: npx playwright-core install chromium-headless-shell
KERNEL_API_KEY=
# CHECKER_BROWSER_CHANNEL=   # e.g. msedge or chrome to use an installed browser locally

# --- Elastic (scope-creep search) ---
ELASTIC_URL=
ELASTIC_API_KEY=
# ELASTIC_INDEX=milestonepay-scope

# --- Zapier ---
# Inbound: POST /api/integrations/zapier/messages with header x-zapier-secret
ZAPIER_SECRET=
# Outbound: a "Catch Hook" URL that receives milestone.released / paid_out / change_request.created
ZAPIER_HOOK_URL=
# Password reset links are sent as an "auth.password_reset_requested" event to this hook; a Zap emails them.
# Email verification links are sent the same way, as "auth.email_verification_requested".
# In local development they are also printed to the server log.

# --- Accounts ---
# DEMO_LOGIN=off          # hide the one-click demo accounts (on by default, for judges)

# --- Channel3 (materials sourcing) ---
CHANNEL3_API_KEY=

# --- AG Grid Enterprise (without a key the grid shows a trial watermark) ---
NEXT_PUBLIC_AG_GRID_LICENSE_KEY=

# --- Operations ---
# Bearer token for POST /api/cron/<job>
CRON_SECRET=
# x-admin-secret for dispute resolution
ADMIN_SECRET=
# Public base URL for PayPal return links (Render sets RENDER_EXTERNAL_URL automatically)
# APP_URL=http://localhost:3000

# --- Database ---
# Unset locally: PGlite stores data in .data/pglite. Render sets this to its Postgres URL.
DATABASE_URL=
