{
  "name": "milestonepay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "paypal:currency-check": "tsx --env-file-if-exists=.env.local scripts/paypal-currency-check.ts",
    "eval:checker": "tsx evals/checker/run-eval.ts",
    "jobs": "tsx scripts/run-jobs.ts",
    "seed:demo": "tsx --env-file-if-exists=.env.local scripts/seed-demo.ts",
    "predev": "node scripts/copy-vendor.mjs",
    "prebuild": "node scripts/copy-vendor.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@bryntum/gantt": "npm:@bryntum/gantt-trial@^7.3.8",
    "@channel3/sdk": "^4.8.0",
    "@elastic/elasticsearch": "^9.5.1",
    "@electric-sql/pglite": "^0.5.15",
    "@onkernel/sdk": "^0.143.0",
    "ag-grid-community": "^36.3.0",
    "ag-grid-enterprise": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "playwright-core": "^1.65.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "newman": "^6.2.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "license": "MIT"
}
